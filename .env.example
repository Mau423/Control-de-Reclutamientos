# Configuración de ControlVacantes
# Copiar este archivo a .env y completar los valores reales

# API Key del agente de IA (NUNCA subir este archivo a GitHub)
IA_API_KEY=tu_api_key_aqui

# Credenciales de acceso (sin base de datos, se leen desde variables de entorno)
APP_USUARIO=
APP_CLAVE=

# Configuración de Flask
FLASK_APP=wsgi.py
FLASK_ENV=development
FLASK_DEBUG=1
